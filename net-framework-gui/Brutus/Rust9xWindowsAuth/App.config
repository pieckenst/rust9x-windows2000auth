<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Authentication Configuration -->
    <!-- Development server endpoints for BRU Avtopark authentication -->
    <add key="AuthUrl" value="https://localhost:5001/api/v1/auth/windows/windows-login" />
    <add key="HttpMethod" value="GET" />
    <add key="RequestBody" value="" />
    <add key="TimeoutMs" value="30000" />
    
    <!-- Credential Dialog Configuration -->
    <add key="AutoPromptCredentials" value="true" />
    <add key="CredentialCaption" value="Windows Authentication Required" />
    <add key="CredentialMessage" value="Enter your network credentials to authenticate with BRU Avtopark" />
    <add key="AllowSaveCredentials" value="false" />
    
    <!-- Pre-configured Credentials (Optional - leave blank to prompt) -->
    <add key="Username" value="" />
    <add key="Password" value="" />
    <add key="Domain" value="" />
    
    <!-- Retry Configuration -->
    <add key="MaxRetryAttempts" value="3" />
    <add key="RetryDelayMs" value="1000" />
    
    <!-- Logging Configuration -->
    <add key="EnableVerboseLogging" value="true" />
    <add key="LogFilePath" value="" />
    
    <!-- Additional Development Server Endpoints -->
    <add key="DevServerHttp" value="http://localhost:5000" />
    <add key="DevServerHttps" value="https://localhost:5001" />
    <add key="WindowsAuthEndpoint" value="/api/v1/auth/windows/windows-login" />
    <add key="AccountLinkEndpoint" value="/api/v1/auth/windows/link-windows-account" />
    <add key="LinkStatusEndpoint" value="/api/v1/auth/windows/check-windows-link-status" />
  </appSettings>
</configuration>